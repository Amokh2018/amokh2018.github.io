---
import Layout from '../layouts/Layout.astro';
import ProjectExplorer from '../components/ProjectExplorer';
import Icon from '../components/Icon';
import {projects} from '../data/portfolio';
---
<Layout active="Projects" title="Selected projects & research" description="Explore Ali Mokh’s 3GPP Knowledge Fabric, agentic AI, traceability, MLOps and GenAI courses, telecom and computer vision work.">
<section class="page-hero shell"><span class="section-number">SELECTED WORK / 01</span><div class="page-title-row"><h1>Ideas, explored.<br/><em>Systems, connected.</em></h1><Icon name="network" size={84}/></div><div class="hero-bottom"><p>Telecom AI research, applied engineering and the learning resources that bring others along.</p><a class="text-link" href="https://github.com/Amokh2018">Explore GitHub <Icon name="arrow" size={18}/></a></div></section>
<section class="section shell portfolio-section"><ProjectExplorer items={projects} client:load/></section>
<div class="shell editorial-note"><Icon name="focus" size={23}/><p>Research themes, project-management contributions and public learning resources are labelled by context. Where code is available, links lead to the specific resource.</p></div>
</Layout>
